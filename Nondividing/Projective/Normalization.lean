import Nondividing.External.DiscreteJohn
import Nondividing.Shell
import Nondividing.Geometry.RealBox
import Mathlib.Analysis.Normed.Module.Basic

open scoped BigOperators

namespace Nondividing

open Nondividing.External

/-!
# Projective normalization (Phase E)

For a shell point `v` with functional value `λ v ≠ 0`, the manuscript works on the
affine hyperplane `{x : λℝ(x) = 1}` via the projective normalization
`π v = (λ v)⁻¹ • v`.  This file sets up an integer linear functional generated by
a coefficient vector, its real extension, their compatibility with the
`realPoint` coercion, and the defining identity `λℝ(π v) = 1`.
-/

/-- An integer linear functional on `Fin d → ℤ` generated by a coefficient vector
`a`. -/
def intFunctional {d : ℕ} (a : Fin d → ℤ) : (Fin d → ℤ) →+ ℤ where
  toFun v := ∑ i, a i * v i
  map_zero' := by simp
  map_add' u v := by simp [mul_add, Finset.sum_add_distrib]

@[simp] theorem intFunctional_apply {d : ℕ} (a : Fin d → ℤ) (v : Fin d → ℤ) :
    intFunctional a v = ∑ i, a i * v i := rfl

/-- The real extension of the integer functional, generated by the same
coefficients. -/
def realFunctional {d : ℕ} (a : Fin d → ℤ) : (Fin d → ℝ) →ₗ[ℝ] ℝ where
  toFun x := ∑ i, (a i : ℝ) * x i
  map_add' u v := by simp [mul_add, Finset.sum_add_distrib]
  map_smul' c x := by
    simp only [Pi.smul_apply, smul_eq_mul, RingHom.id_apply, Finset.mul_sum]
    exact Finset.sum_congr rfl fun i _ => by ring

@[simp] theorem realFunctional_apply {d : ℕ} (a : Fin d → ℤ) (x : Fin d → ℝ) :
    realFunctional a x = ∑ i, (a i : ℝ) * x i := rfl

/-- Compatibility: the real extension agrees with the integer functional on
integer points. -/
theorem realFunctional_realPoint {d : ℕ} (a : Fin d → ℤ) (v : Fin d → ℤ) :
    realFunctional a (realPoint v) = (intFunctional a v : ℤ) := by
  simp only [realFunctional_apply, intFunctional_apply, realPoint]
  push_cast
  rfl

/-- Projective normalization: `π v = (λ v)⁻¹ • v`, on the real hyperplane. -/
noncomputable def projNorm {d : ℕ} (a : Fin d → ℤ) (v : Fin d → ℤ) : Fin d → ℝ :=
  ((intFunctional a v : ℤ) : ℝ)⁻¹ • realPoint v

/-- The defining identity: `λℝ(π v) = 1` whenever `λ v ≠ 0`. -/
theorem realFunctional_projNorm {d : ℕ} (a : Fin d → ℤ) (v : Fin d → ℤ)
    (hv : intFunctional a v ≠ 0) :
    realFunctional a (projNorm a v) = 1 := by
  have hv' : ((intFunctional a v : ℤ) : ℝ) ≠ 0 := by exact_mod_cast hv
  rw [projNorm, map_smul, realFunctional_realPoint, smul_eq_mul,
    inv_mul_cancel₀ hv']

/-- Shell points have positive functional value (`X ≥ 1`), hence `π` is
well-defined on them. -/
theorem intFunctional_pos_of_shell {d : ℕ} {a : Fin d → ℤ} {X : ℕ}
    {V : Finset (Fin d → ℤ)} (hX : 1 ≤ X)
    (hV : ShellNonDividing (fun v => (intFunctional a v : ℤ)) X V)
    {v : Fin d → ℤ} (hv : v ∈ V) : 0 < intFunctional a v := by
  have hb := (hV.1 v hv).1
  have : (1 : ℤ) ≤ (X : ℤ) := by exact_mod_cast hX
  linarith

/-- Consequently the projective normalization of a shell point lies on the
hyperplane `{λℝ = 1}`. -/
theorem realFunctional_projNorm_of_shell {d : ℕ} {a : Fin d → ℤ} {X : ℕ}
    {V : Finset (Fin d → ℤ)} (hX : 1 ≤ X)
    (hV : ShellNonDividing (fun v => (intFunctional a v : ℤ)) X V)
    {v : Fin d → ℤ} (hv : v ∈ V) :
    realFunctional a (projNorm a v) = 1 :=
  realFunctional_projNorm a v (ne_of_gt (intFunctional_pos_of_shell hX hV hv))

/-- **Projective support in the box** (`lem:projective-span`, containment).  For
a shell point `v` (with `X ≤ λv ≤ 2X`, `X ≥ 1`) inside the coordinate box, the
scaled projective image `X·π(v) = (X/λv)·v` lies in the real box, since
`X/λv ∈ [1/2,1] ⊆ [0,1]` and the box is convex, symmetric and contains `0`. -/
theorem smul_projNorm_mem_realBox {d : ℕ} {a : Fin d → ℤ} {X : ℕ} {v : Fin d → ℤ}
    {M : Fin d → ℕ} (hX : 1 ≤ X)
    (hlo : (X : ℤ) ≤ intFunctional a v) (hv : v ∈ coordinateBox M) :
    (X : ℝ) • projNorm a v ∈ realCoordinateBox M := by
  have hlam_pos : 0 < intFunctional a v := by
    have : (1 : ℤ) ≤ (X : ℤ) := by exact_mod_cast hX
    linarith
  have hlam_R : (0 : ℝ) < (intFunctional a v : ℝ) := by exact_mod_cast hlam_pos
  have hrw : (X : ℝ) • projNorm a v =
      ((X : ℝ) / (intFunctional a v : ℝ)) • realPoint v := by
    rw [projNorm, smul_smul, div_eq_mul_inv]
  set ρ := (X : ℝ) / (intFunctional a v : ℝ) with hρ
  have hρ0 : 0 ≤ ρ := by rw [hρ]; positivity
  have hρ1 : ρ ≤ 1 := by
    rw [hρ, div_le_one hlam_R]; exact_mod_cast hlo
  rw [hrw, mem_realCoordinateBox]
  intro i
  have hvi := (mem_coordinateBox.mp hv) i
  have hviR_lo : -(M i : ℝ) ≤ (v i : ℝ) := by exact_mod_cast hvi.1
  have hviR_hi : (v i : ℝ) ≤ (M i : ℝ) := by exact_mod_cast hvi.2
  have hMnn : (0 : ℝ) ≤ (M i : ℝ) := Nat.cast_nonneg _
  simp only [Pi.smul_apply, realPoint, smul_eq_mul]
  constructor
  · nlinarith [hρ0, hρ1, hviR_lo, hviR_hi, hMnn]
  · nlinarith [hρ0, hρ1, hviR_lo, hviR_hi, hMnn]

/-- If the shell set `V` spans `ℝ^d` and its functional is nonvanishing on `V`,
then the projective images `π(V)` linearly span `ℝ^d` (as `v = λ(v)·π(v)`).  This
underlies the full affine span `aff π(V) = H_λ`. -/
theorem span_projNorm_eq_top {d : ℕ} (a : Fin d → ℤ) {V : Finset (Fin d → ℤ)}
    (hspan : integerRealSpan V = ⊤)
    (hpos : ∀ v ∈ V, intFunctional a v ≠ 0) :
    Submodule.span ℝ (projNorm a '' (V : Set (Fin d → ℤ))) = ⊤ := by
  rw [eq_top_iff, ← hspan, integerRealSpan, Submodule.span_le]
  rintro _ ⟨v, hv, rfl⟩
  have hne : ((intFunctional a v : ℤ) : ℝ) ≠ 0 := by exact_mod_cast hpos v hv
  have hrw : realPoint v = (intFunctional a v : ℝ) • projNorm a v := by
    rw [projNorm, smul_inv_smul₀ hne]
  rw [SetLike.mem_coe, hrw]
  exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨v, hv, rfl⟩)

end Nondividing
