import Nondividing.External.DiscreteJohn
import Mathlib.Analysis.Normed.Module.Basic

open scoped BigOperators

namespace Nondividing

open Nondividing.External

/-!
# Projective normalization (Phase E)

For a shell point `v` with functional value `λ v ≠ 0`, the manuscript works on the
affine hyperplane `{x : λℝ(x) = 1}` via the projective normalization
`π v = (λ v)⁻¹ • v`.  This file sets up an integer linear functional generated by
a coefficient vector, its real extension, their compatibility with the
`realPoint` coercion, and the defining identity `λℝ(π v) = 1`.
-/

/-- An integer linear functional on `Fin d → ℤ` generated by a coefficient vector
`a`. -/
def intFunctional {d : ℕ} (a : Fin d → ℤ) : (Fin d → ℤ) →+ ℤ where
  toFun v := ∑ i, a i * v i
  map_zero' := by simp
  map_add' u v := by simp [mul_add, Finset.sum_add_distrib]

@[simp] theorem intFunctional_apply {d : ℕ} (a : Fin d → ℤ) (v : Fin d → ℤ) :
    intFunctional a v = ∑ i, a i * v i := rfl

/-- The real extension of the integer functional, generated by the same
coefficients. -/
def realFunctional {d : ℕ} (a : Fin d → ℤ) : (Fin d → ℝ) →ₗ[ℝ] ℝ where
  toFun x := ∑ i, (a i : ℝ) * x i
  map_add' u v := by simp [mul_add, Finset.sum_add_distrib]
  map_smul' c x := by
    simp only [Pi.smul_apply, smul_eq_mul, RingHom.id_apply, Finset.mul_sum]
    exact Finset.sum_congr rfl fun i _ => by ring

@[simp] theorem realFunctional_apply {d : ℕ} (a : Fin d → ℤ) (x : Fin d → ℝ) :
    realFunctional a x = ∑ i, (a i : ℝ) * x i := rfl

/-- Compatibility: the real extension agrees with the integer functional on
integer points. -/
theorem realFunctional_realPoint {d : ℕ} (a : Fin d → ℤ) (v : Fin d → ℤ) :
    realFunctional a (realPoint v) = (intFunctional a v : ℤ) := by
  simp only [realFunctional_apply, intFunctional_apply, realPoint]
  push_cast
  rfl

/-- Projective normalization: `π v = (λ v)⁻¹ • v`, on the real hyperplane. -/
noncomputable def projNorm {d : ℕ} (a : Fin d → ℤ) (v : Fin d → ℤ) : Fin d → ℝ :=
  ((intFunctional a v : ℤ) : ℝ)⁻¹ • realPoint v

/-- The defining identity: `λℝ(π v) = 1` whenever `λ v ≠ 0`. -/
theorem realFunctional_projNorm {d : ℕ} (a : Fin d → ℤ) (v : Fin d → ℤ)
    (hv : intFunctional a v ≠ 0) :
    realFunctional a (projNorm a v) = 1 := by
  have hv' : ((intFunctional a v : ℤ) : ℝ) ≠ 0 := by exact_mod_cast hv
  rw [projNorm, map_smul, realFunctional_realPoint, smul_eq_mul,
    inv_mul_cancel₀ hv']

end Nondividing
