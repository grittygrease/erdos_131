# --- Lean 4 / Lake ---------------------------------------------------------
# Build cache, downloaded packages, and compiled artifacts. Regenerated by
# `lake build`; must never be committed (mathlib cache is hundreds of MB).
/.lake/
/build/
/lake-packages/
*.olean
*.ilean
*.trace

# NOTE: lake-manifest.json and lean-toolchain ARE tracked on purpose — they
# pin the exact mathlib commit and Lean version for reproducible builds.

# --- LaTeX build artifacts -------------------------------------------------
# Manuscript.tex is the source and IS tracked. Everything below is generated
# by latexmk / pdflatex and is regenerable.
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.lof
*.log
*.lot
*.nav
*.out
*.run.xml
*.snm
*.synctex.gz
*.toc
*.vrb

# The compiled PDF is tracked by default so readers get the paper. To stop
# tracking it, uncomment the next line and run `git rm --cached Manuscript.pdf`.
# Manuscript.pdf

# --- Editors / OS ----------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*~
.idea/

# --- Scratch / logs --------------------------------------------------------
scratch/
*.tmp

# --- Comparator / Lean 4 Web ----------------------------------------------
# Self-contained single-file version of Challenge.lean for pasting into
# live.lean-lang.org / comparator.live (regenerable; see README).
/comparator_web.lean
